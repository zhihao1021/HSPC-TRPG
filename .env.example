# ===== Discord =====
DISCORD_BOT_TOKEN=

# ===== PostgreSQL =====
POSTGRES_DB_URL=postgresql://hspc:hspc@localhost:5432/hspc_trpg
POSTGRES_POOL_MIN_SIZE=5
POSTGRES_POOL_MAX_SIZE=10

# ===== Deepseek (OpenAI 相容官方 API) =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 一般對話/工具呼叫使用 deepseek-chat;若要強推理可改 deepseek-reasoner
DEEPSEEK_MODEL=deepseek-chat
# 啟用 thinking 模式(會嘗試讀取 reasoning_content)
DEEPSEEK_REASONING_ENABLED=true
DEEPSEEK_TEMPERATURE=1.0
DEEPSEEK_MAX_TOKENS=4096
# 單次回應中 tool-calling 迴圈最大往返次數
LLM_MAX_TOOL_ITERATIONS=6
# 私訊創角使用的模型;留空則沿用 DEEPSEEK_MODEL
CHARGEN_MODEL=

# ===== Context 管理 (Deepseek v4 context window 約 1M) =====
# 壓縮 Context(摘要)使用的模型;留空則沿用 DEEPSEEK_MODEL
CONTEXT_SUMMARY_MODEL=
# 模型 context window 總大小(token)
CONTEXT_WINDOW=1000000
# 當 prompt token 用量超過 window 的此比例時觸發壓縮(0.75 = 75%)
CONTEXT_TRIGGER_RATIO=0.75
# 壓縮比率:壓縮後把 context 縮減到 window 的此比例
CONTEXT_COMPRESS_RATIO=0.5
# 壓縮時至少保留的最近訊息則數
CONTEXT_KEEP_RECENT=40
# 組裝請求時最多撈取的歷史訊息則數
CONTEXT_MAX_FETCH=400

# ===== 晉級名單 =====
ROSTER_FILE=data/roster.json

# ===== 其他 =====
# 是否將模型 thinking 內容輸出到 Discord
SHOW_REASONING=false
